---
import { site } from "@content/site";
import MaggieFace from "./MaggieFace.astro";
---

<footer class="site-footer" style="background: var(--color-mint); overflow: hidden; position: relative;">
  <!-- Huge curved yellow top overlap -->
  <div class="footer-cta" style="background: var(--color-yellow); border-radius: 50% 50% 0 0 / 100px 100px 0 0; padding: 120px 20px 80px; margin-top: -50px; position: relative; z-index: 10;">
    <div class="footer-cta-inner" style="max-width: 1200px; margin: 0 auto; text-align: center;">
      <!-- Simple face illustration from image -->
      <div style="display: flex; justify-content: center; margin-bottom: 24px;">
        <svg viewBox="0 0 200 100" width="200" height="100">
           <circle cx="50" cy="40" r="28" fill="var(--color-ink)"/>
           <circle cx="150" cy="40" r="28" fill="var(--color-ink)"/>
           <path d="M 70 80 A 30 30 0 0 0 130 80 Z" fill="var(--color-ink)"/>
        </svg>
      </div>

      <!-- Giant Heading -->
      <h2 style="font-family: var(--font-display); font-size: clamp(48px, 10vw, 140px); color: var(--color-ink); line-height: 0.85; text-transform: uppercase; margin-bottom: 24px; letter-spacing: -0.02em;">
        {site.footerCta}
      </h2>
      
      <!-- Script Subheading -->
      <p style="font-family: var(--font-script); font-size: clamp(24px, 4vw, 40px); color: var(--color-ink); transform: rotate(-3deg); margin-top: 40px; margin-bottom: 60px;">
        {site.footerSub}
      </p>
      
      <!-- Action Buttons -->
      <div style="display: flex; justify-content: center; gap: 16px; flex-wrap: wrap;">
        <a class="pill-button" href={site.appStoreUrl} style="background: var(--color-ink); color: var(--color-white); border: 2px solid var(--color-ink); box-shadow: 4px 4px 0 var(--color-ink); padding: 16px 40px; font-size: 20px;">
          Get Started for Free
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom Legal Row -->
  <div class="footer-bottom" style="background: var(--color-mint); padding: 24px 40px 40px; display: flex; justify-content: space-between; align-items: center; position: relative; z-index: 11;">
    <!-- Socials (Left) -->
    <div class="footer-socials" style="display: flex; gap: 16px;">
      <a href="#" style="width: 56px; height: 56px; border-radius: 50%; background: var(--color-pink); border: 2px solid var(--color-ink); display: flex; align-items: center; justify-content: center; box-shadow: 3px 3px 0 var(--color-ink); color: var(--color-ink); transition: transform 0.2s;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
      </a>
      <a href="#" style="width: 56px; height: 56px; border-radius: 50%; background: var(--color-cyan); border: 2px solid var(--color-ink); display: flex; align-items: center; justify-content: center; box-shadow: 3px 3px 0 var(--color-ink); color: var(--color-ink); transition: transform 0.2s;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path></svg>
      </a>
    </div>

    <!-- Copyright (Center) -->
    <div style="font-family: var(--font-script); font-size: 28px; color: var(--color-ink); text-align: center;">
      © 2026 UrbanEvents
    </div>

    <!-- Policies & FAQs (Right) -->
    <div style="display: flex; gap: 12px;">
      <a href="/faqs" class="pill-button" style="background: var(--color-white); color: var(--color-ink); border: 2px solid var(--color-ink); box-shadow: 3px 3px 0 var(--color-ink); padding: 12px 32px; font-size: 16px;">FAQS</a>
      <a href="/policies" class="pill-button" style="background: var(--color-peach); color: var(--color-ink); border: 2px solid var(--color-ink); box-shadow: 3px 3px 0 var(--color-ink); padding: 12px 32px; font-size: 16px;">POLICIES</a>
    </div>
  </div>
</footer>
