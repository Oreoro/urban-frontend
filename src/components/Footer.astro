---
import { site } from "@content/site";
---

<footer class="site-footer">
  <div class="footer-bottom">
    <span>© 2025 Maggie</span>
    <a href="/policies">POLICIES</a>
    <a class="app-store-badge app-store-badge-small" href={site.appStoreUrl} aria-label="Download Maggie on the App Store">
      <svg viewBox="0 0 120 40" aria-hidden="true" class="app-store-svg">
        <rect rx="9" width="120" height="40" fill="#000"/>
        <text x="60" y="15" text-anchor="middle" fill="#fff" font-size="7" font-family="system-ui, sans-serif">Download on the</text>
        <text x="60" y="29" text-anchor="middle" fill="#fff" font-size="13" font-weight="600" font-family="system-ui, sans-serif">App Store</text>
      </svg>
    </a>
  </div>
</footer>
