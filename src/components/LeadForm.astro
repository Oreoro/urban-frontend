---
import { site } from "@content/site";

interface Props {
  type?: "contact" | "venue";
}

const { type = "contact" } = Astro.props;
const fields =
  type === "venue"
    ? [
        { name: "name", label: "Your name", type: "text" },
        { name: "venue", label: "Venue's name", type: "text" },
        { name: "email", label: "Your email", type: "email" }
      ]
    : [
        { name: "name", label: "Your name", type: "text" },
        { name: "email", label: "Your email", type: "email" }
      ];
---

<form class="lead-form" data-lead-form data-lead-email={site.email}>
  {fields.map((field) => (
    <label>
      <span>{field.label}</span>
      <input type={field.type} name={field.name} placeholder={field.label} autocomplete={field.type === "email" ? "email" : "name"} required />
    </label>
  ))}
  <label>
    <span>Message (optional)</span>
    <textarea name="message" placeholder="Tell us about your event"></textarea>
  </label>
  <button class="button button-brand button-medium" type="submit">Send message</button>
  <p class="lead-form-status" data-lead-status hidden role="status"></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>("[data-lead-form]").forEach((form) => {
    const status = form.querySelector<HTMLElement>("[data-lead-status]");
    const email = form.dataset.leadEmail ?? "hello@urbanevents.pk";
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const subject = "Enquiry from urbanevents.pk";
      const body = Array.from(data.entries())
        .filter(([, v]) => String(v).trim())
        .map(([k, v]) => `${k}: ${v}`)
        .join("\n");
      window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      if (status) {
        status.hidden = false;
        status.textContent = "Your email app should open — if it doesn't, write to us directly.";
      }
    });
  });
</script>
