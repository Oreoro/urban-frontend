---
interface Props {
  eyebrow: string;
  heading: string;
  body?: string[];
}

const { eyebrow, heading, body = [] } = Astro.props;
---

<section class="page-panel">
  <p class="section-kicker">{eyebrow}</p>
  <h1>{heading}</h1>
  <div class="copy-stack">
    {body.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</section>
