---
interface Props {
  eyebrow: string;
  heading: string;
  body?: string[];
}

const { eyebrow, heading, body = [] } = Astro.props;
---

<section class="page-panel">
  <div class="container">
    <p class="kicker" data-reveal>{eyebrow}</p>
    <h1 data-reveal>{heading}</h1>
    <div class="copy-stack" data-reveal>
      {body.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>
