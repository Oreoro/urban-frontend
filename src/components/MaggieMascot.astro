---
interface Props {
  size?: number;
  color?: string;
  accent?: string;
  class?: string;
}

const {
  size = 200,
  color = "#0F4A3F",
  accent = "#FFF8B5",
  class: className = "",
} = Astro.props;
---

<svg
  class:list={["maggie-mascot", className]}
  width={size}
  viewBox="0 0 200 240"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <!-- Body -->
  <path
    d="M30 100 Q30 20 100 20 Q170 20 170 100 L170 220 Q170 230 160 230
       L130 230 Q120 230 120 220 L120 190 Q120 180 110 180 L90 180
       Q80 180 80 190 L80 220 Q80 230 70 230 L40 230 Q30 230 30 220 Z"
    fill={color}
  />
  <!-- Eyes -->
  <circle cx="75" cy="105" r="11" fill={accent} />
  <circle cx="125" cy="105" r="11" fill={accent} />
  <!-- Smile -->
  <path d="M88 130 A12 12 0 0 0 112 130 Z" fill={accent} />
</svg>
