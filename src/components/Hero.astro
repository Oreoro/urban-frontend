---
import { home } from "@content/home";
import { site } from "@content/site";
---

<section class="hero-section" data-hero id="start">
  <div class="hero-inner">
    <p class="hero-eyebrow">{home.hero.eyebrow}</p>
    <h1 class="hero-title">{home.hero.title}</h1>
    <div class="cta-row">
      <a class="app-store-badge" href={home.hero.primaryCtaHref} aria-label="Download Maggie on the App Store">
        <svg viewBox="0 0 120 40" aria-hidden="true" class="app-store-svg">
          <rect rx="9" width="120" height="40" fill="#000"/>
          <text x="60" y="15" text-anchor="middle" fill="#fff" font-size="7" font-family="system-ui, sans-serif">Download on the</text>
          <text x="60" y="29" text-anchor="middle" fill="#fff" font-size="13" font-weight="600" font-family="system-ui, sans-serif">App Store</text>
        </svg>
      </a>
    </div>
  </div>
</section>
