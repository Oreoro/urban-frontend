---
/**
 * MaggieFace — The simplified mascot face (eyes + smile only).
 * Used as a decorative element across sections, inspired by maggie-app.com.
 *
 * Variants:
 *   - "icon"    → Small, for nav/header (no background)
 *   - "badge"   → Medium, rounded-rect background (hero icon)
 *   - "hero"    → Large, full background rectangle
 *   - "section" → Decorative floating face
 *   - "footer"  → Giant, faded background element
 */
interface Props {
  size?: number;
  bg?: string;
  fg?: string;
  variant?: "icon" | "badge" | "hero" | "section" | "footer";
  class?: string;
}

const {
  size = 200,
  bg = "#FBF681",
  fg = "#0E4D3C",
  variant = "icon",
  class: className = "",
} = Astro.props;

// For "icon" variant, no background rect
const showBg = variant !== "icon";
---

<svg
  class:list={["maggie-face", `maggie-face--${variant}`, className]}
  width={size}
  viewBox="0 0 600 500"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  {showBg && <rect width="600" height="500" rx="250" fill={bg} />}
  <!-- Left eye -->
  <circle cx="210" cy="190" r="75" fill={fg} />
  <!-- Right eye -->
  <circle cx="390" cy="190" r="75" fill={fg} />
  <!-- Smile (Wide U-shape with flat top) -->
  <path d="M 230 310 A 70 70 0 0 0 370 310 Z" fill={fg} />
</svg>
