---
import Layout from "@layouts/Layout.astro";
import { pages } from "@content/pages";
import { site } from "@content/site";

const page = pages.about;
---

<Layout title={page.title} description={page.description} canonical="/about">
  <section class="subpage-section">
    <div class="container">
      <p class="kicker" data-reveal>{page.eyebrow}</p>
      <h1 class="page-panel-h" data-reveal style="font-size: clamp(36px,4.6vw,64px); letter-spacing:-0.045em; line-height:1.02; max-width:820px;">
        {page.heading}
      </h1>

      <div class="subpage-body" style="margin-top: 40px;" data-reveal>
        {page.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <h2 class="subpage-subheading" data-reveal>{page.subheading}</h2>

      <div class="subpage-body" data-reveal>
        <blockquote class="blockquote-standalone">
          <p style="font-size: clamp(18px,1.8vw,24px); line-height:1.5; color: var(--ink); margin:0;">
            "{page.pullquote}"
          </p>
          <footer>{page.close}</footer>
        </blockquote>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-band-inner">
      <h2 data-reveal>{page.ctaHeading}</h2>
      <div class="hero-actions" data-reveal>
        <a class="button button-brand button-large" href={site.appUrl + site.registerPath}>Create your event</a>
        <a class="button button-ghost button-large" href={page.ctaHref}>{page.ctaLabel}</a>
      </div>
    </div>
  </section>
</Layout>
