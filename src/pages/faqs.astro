---
import FAQList from "@components/FAQList.astro";
import Layout from "@layouts/Layout.astro";
import { faqPage, faqs } from "@content/faqs";
---

<Layout title={faqPage.title} description={faqPage.description} canonical="/faqs">
  <section class="subpage-section">
    <div class="container">
      <p class="kicker" data-reveal>{faqPage.eyebrow}</p>
      <h1 data-reveal style="font-size: clamp(36px,4.6vw,64px); letter-spacing:-0.045em; line-height:1.02; max-width:820px;">
        {faqPage.heading}
      </h1>
    </div>
  </section>

  <section class="section" style="border-top: 0; padding-top: 0;">
    <div class="container">
      <FAQList items={faqs} />
    </div>
  </section>
</Layout>
