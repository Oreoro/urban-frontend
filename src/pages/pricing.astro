---
import Layout from "@layouts/Layout.astro";
import { pages } from "@content/pages";

const page = pages.pricing;
---

<Layout title={page.title} description={page.description} canonical="/pricing">
  <section class="subpage-section" style="padding-bottom: 32px;">
    <div class="container">
      <p class="kicker" data-reveal>{page.eyebrow}</p>
      <h1 data-reveal style="font-size: clamp(36px,4.6vw,64px); letter-spacing:-0.045em; line-height:1.02;">
        {page.heading}
      </h1>
      <div class="subpage-body" data-reveal>
        <p>{page.subheading}</p>
      </div>
    </div>
  </section>

  <section class="section" style="border-top: 0; padding-top: 24px;">
    <div class="container">
      <div class="pricing-grid" style="max-width: 920px;">
        {page.tiers.map((tier) => (
          <article class="pricing-card" data-reveal data-featured={tier.featured ? "" : undefined}>
            <p class="pricing-tier">{tier.name}</p>
            <p class="pricing-price">{tier.price} <small>{tier.period}</small></p>
            <p class="pricing-desc">{tier.description}</p>
            <ul class="pricing-features">
              {tier.features.map((f) => <li>{f}</li>)}
            </ul>
            <a
              class={`button ${tier.featured ? "button-brand" : "button-ghost"} button-medium`}
              href={tier.href}
            >
              {tier.cta}
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-band-inner">
      <h2 data-reveal>{page.ctaHeading}</h2>
      <div class="hero-actions" data-reveal>
        <a class="button button-brand button-large" href={page.ctaHref}>{page.ctaLabel}</a>
      </div>
    </div>
  </section>
</Layout>
