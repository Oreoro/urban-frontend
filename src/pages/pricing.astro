---
import Layout from "@layouts/Layout.astro";
import { pages } from "@content/pages";
import MaggieFace from "@components/MaggieFace.astro";

const page = pages.pricing;
---

<Layout title={page.title} description={page.description} canonical="/pricing" bodyClass={page.theme}>
  <section class="subpage-section" style="padding-bottom: 40px; position: relative; z-index: 1;">
    <!-- Colorful floating stickers -->
    <div class="floating-items" aria-hidden="true" style="position: absolute; inset: 0; pointer-events: none; z-index: 1;">
      <div class="sticker" style="position: absolute; top: 2%; left: 2%;">
        <MaggieFace size={70} variant="section" bg="#82eda6" />
      </div>
      <div class="sticker" style="position: absolute; top: 5%; right: 2%;">
        <MaggieFace size={90} variant="badge" bg="#FBF681" />
      </div>
      <div class="sticker" style="position: absolute; bottom: 2%; left: 5%;">
        <MaggieFace size={60} variant="section" bg="#fdc068" />
      </div>
    </div>

    <div class="subpage-inner" data-reveal style="position: relative; max-width: 900px; margin: 0 auto; text-align: center; z-index: 2;">
      <p class="subpage-eyebrow" style="margin-bottom: 24px; display: inline-block;">{page.eyebrow}</p>
      <h1 class="subpage-heading" style="margin-bottom: 24px; font-size: clamp(40px, 8vw, 80px);">{page.heading}</h1>
      
      <p style="font-size: clamp(20px, 3vw, 28px); color: var(--ink); font-family: var(--font-strong); line-height: 1.4; margin-bottom: 48px; background: rgba(255,255,255,0.4); padding: 24px; border-radius: 24px; backdrop-filter: blur(10px); display: inline-block;">
        {page.subheading}
      </p>
    </div>
  </section>

  <section class="pricing-tiers-section" style="padding: 0 24px 120px; position: relative; z-index: 2;">
    <div class="container-inner" style="max-width: 1000px;">
      <div class="pricing-grid">
        {page.tiers.map((tier) => (
          <div class="pricing-card" style={`background: ${tier.color};`} data-reveal>
            <div class="pricing-header">
              <h2 class="tier-name">{tier.name}</h2>
              <div class="tier-price-box">
                <span class="tier-price">{tier.price}</span>
                <span class="tier-period">{tier.period}</span>
              </div>
              <p class="tier-desc">{tier.description}</p>
            </div>
            
            <ul class="tier-features">
              {tier.features.map(feat => (
                <li>
                  <span class="check-icon">✓</span>
                  {feat}
                </li>
              ))}
            </ul>
            
            <a href={tier.href} class="pill-button tier-cta" style="background: var(--white); color: var(--ink);">{tier.cta}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-overlap-card" style="background: var(--yellow);">
    <div class="section-inner" data-reveal style="max-width: 800px; margin: 0 auto; text-align: center;">
      <div style="margin-bottom: 24px; display: inline-block; transform: rotate(-5deg);">
        <MaggieFace size={100} variant="hero" />
      </div>
      <h2 style="font-family: var(--font-display); font-size: clamp(40px, 6vw, 80px); color: var(--ink); text-transform: uppercase; margin-bottom: 40px;">{page.ctaHeading}</h2>
      <a href={page.ctaHref} class="pill-button" style="font-size: 20px; background: var(--pink);">{page.ctaLabel}</a>
    </div>
  </section>
</Layout>

<style>
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 40px;
  }
  .pricing-card {
    border: 3px solid var(--ink);
    border-radius: var(--radius-xl);
    padding: 48px;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }
  .pricing-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 12px;
    background: rgba(255,255,255,0.3);
    border-bottom: 3px solid var(--ink);
  }
  .tier-name {
    font-family: var(--font-display);
    font-size: 32px;
    color: var(--ink);
    text-transform: uppercase;
    margin-bottom: 24px;
    text-align: center;
  }
  .tier-price-box {
    background: var(--white);
    border: 3px solid var(--ink);
    border-radius: var(--radius-lg);
    padding: 24px;
    text-align: center;
    box-shadow: 4px 4px 0 var(--ink);
    margin-bottom: 24px;
    transform: rotate(-2deg);
  }
  .tier-price {
    display: block;
    font-family: var(--font-display);
    font-size: 64px;
    line-height: 1;
    color: var(--ink);
  }
  .tier-period {
    display: block;
    font-family: var(--font-strong);
    font-size: 16px;
    color: var(--ink-soft);
    margin-top: 8px;
    text-transform: uppercase;
  }
  .tier-desc {
    font-size: 18px;
    color: var(--ink);
    text-align: center;
    margin-bottom: 32px;
    line-height: 1.4;
  }
  .tier-features {
    list-style: none;
    padding: 0;
    margin: 0 0 40px 0;
    flex-grow: 1;
  }
  .tier-features li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 18px;
    color: var(--ink);
    margin-bottom: 16px;
    line-height: 1.4;
  }
  .check-icon {
    font-weight: bold;
    color: var(--ink);
    background: var(--white);
    border: 2px solid var(--ink);
    border-radius: 50%;
    width: 24px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 14px;
  }
  .tier-cta {
    width: 100%;
    text-align: center;
    justify-content: center;
    font-size: 20px;
    background: var(--white);
    color: var(--ink);
  }
</style>
