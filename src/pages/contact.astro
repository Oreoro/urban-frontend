---
import LeadForm from "@components/LeadForm.astro";
import Layout from "@layouts/Layout.astro";
import { pages } from "@content/pages";

const page = pages.contact;
---

<Layout title={page.title} description={page.description} canonical="/contact">
  <section class="subpage-section">
    <div class="container">
      <p class="kicker" data-reveal>{page.eyebrow}</p>
      <h1 data-reveal style="font-size: clamp(36px,4.6vw,64px); letter-spacing:-0.045em; line-height:1.02;">
        {page.heading}
      </h1>

      <div class="subpage-body" style="margin-top: 32px;" data-reveal>
        <p>{page.emailIntro}</p>
      </div>

      <p style="margin-top: 16px;" data-reveal>
        <a class="button button-ghost button-large" href={`mailto:${page.email}`}>
          {page.email}
        </a>
      </p>

      <h2 class="subpage-subheading" data-reveal>{page.formHeading}</h2>
      <div class="subpage-body" data-reveal>
        <p>{page.formIntro}</p>
      </div>

      <div style="margin-top: 32px;" data-reveal>
        <LeadForm type="contact" />
      </div>
    </div>
  </section>
</Layout>
