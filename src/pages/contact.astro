---
import LeadForm from "@components/LeadForm.astro";
import Layout from "@layouts/Layout.astro";
import { pages } from "@content/pages";
import MaggieFace from "@components/MaggieFace.astro";

const page = pages.contact;
---

<Layout title={page.title} description={page.description} canonical="/contact" bodyClass={page.theme}>
  <section class="subpage-section" style="padding-bottom: 120px;">
    <div class="subpage-inner" data-reveal style="position: relative; max-width: 800px; margin: 0 auto; text-align: center;">
      <!-- Floating face decoration -->
      <div style="position: absolute; top: -10px; left: -20px; opacity: 0.9; transform: rotate(-15deg);">
        <MaggieFace size={70} variant="badge" bg="#FBF681" />
      </div>

      <h1 class="subpage-heading">{page.heading}</h1>
      
      <div class="form-divider-text" style="position: relative; margin: 40px 0;">
        <div style="position: absolute; top: 50%; left: 0; right: 0; height: 2px; background: var(--line); z-index: 1;"></div>
        <span style="position: relative; z-index: 2; background: var(--mint); padding: 0 20px; font-family: var(--font-display); font-size: clamp(24px, 4vw, 32px); color: var(--ink); text-transform: uppercase;">{page.emailIntro}</span>
      </div>
      
      <a href={`mailto:${page.email}`} style="display: inline-flex; align-items: center; gap: 12px; padding: 16px 40px; background: var(--white); border: 3px solid var(--ink); border-radius: var(--radius-full); box-shadow: var(--shadow); font-family: var(--font-strong); font-size: 18px; color: var(--ink); text-transform: uppercase; transition: transform 200ms ease;">
        {page.email}
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
      </a>
    </div>
  </section>

  <section class="section-overlap-card">
    <div class="section-inner" data-reveal style="max-width: 800px; margin: 0 auto;">
      <div class="form-divider-text" style="position: relative; margin: 0 0 40px; text-align: center;">
        <div style="position: absolute; top: 50%; left: 0; right: 0; height: 2px; background: var(--line); z-index: 1;"></div>
        <span style="position: relative; z-index: 2; background: var(--cream); padding: 0 20px; font-family: var(--font-display); font-size: clamp(24px, 4vw, 32px); color: var(--ink); text-transform: uppercase;">{page.formHeading}</span>
      </div>

      <div class="form-wrapper" style="margin-top: 0; text-align: left;">
        <p style="text-align: center; margin-bottom: 32px; font-size: 18px;">{page.formIntro}</p>
        <div style="border-bottom: 2px solid var(--line); margin-bottom: 32px;"></div>
        <LeadForm type="contact" />
      </div>
    </div>
  </section>
</Layout>
