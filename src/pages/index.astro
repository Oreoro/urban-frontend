---
import FAQList from "@components/FAQList.astro";
import Layout from "@layouts/Layout.astro";
import { site } from "@content/site";
import { home } from "@content/home";

const capabilities = home.capabilities;

const capIcons = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2.5a2.5 2.5 0 0 0 0 5V17a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2.5a2.5 2.5 0 0 0 0-5Z"/><path d="M14 5v14" stroke-dasharray="0.1 4.2"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2"/><path d="M4 12h16"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="12" rx="2"/><circle cx="12" cy="12" r="2.4"/><path d="M7 12h.01M17 12h.01"/></svg>'
];

const softwareSchema = {
  "@type": "SoftwareApplication",
  name: site.name,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  url: site.url,
  description: site.description,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "PKR",
    description: "Free for free events"
  }
};

const faqSchema = {
  "@type": "FAQPage",
  mainEntity: home.faqTeaser.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer }
  }))
};

const structuredData = [softwareSchema, faqSchema];
---

<Layout minimal title={site.title} description={site.description} canonical="/" structuredData={structuredData}>
  <header slot="header" class="minimal-header">
    <div class="header-shell">
      <a class="mini-brand" href="/" aria-label="Urban Events home">
        <svg class="mini-brand-mark" width="22" height="22" viewBox="0 0 64 64" aria-hidden="true">
          <rect width="64" height="64" rx="14" fill="#006ac4" />
          <path d="M18 21h28a4 4 0 0 1 4 4v14a4 4 0 0 1-4 4H18a4 4 0 0 1-4-4V25a4 4 0 0 1 4-4Z" fill="#fafaf8" />
          <circle cx="14" cy="32" r="4.4" fill="#006ac4" />
          <circle cx="50" cy="32" r="4.4" fill="#006ac4" />
          <path d="M31.5 24.5v15" stroke="#006ac4" stroke-width="2.2" stroke-linecap="round" stroke-dasharray="0.1 5.2" />
        </svg>
        <span>Urban Events</span>
      </a>

      <nav class="mini-nav" aria-label="Primary">
        {site.nav.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>

      <nav class="header-actions" aria-label="Account">
        <a class="header-login" href={site.appUrl}>Log in</a>
        <a class="button button-brand header-cta" href={site.appUrl + site.registerPath}>
          Create event
        </a>
      </nav>
    </div>
  </header>

  <!-- ===== HERO ===== -->
  <section class="single-hero" aria-labelledby="hero-title">
    <div class="hero-stage">
      <div class="hero-center">
        <p class="hero-kicker rise" style="animation-delay:0.1s">{home.hero.kicker}</p>
        <h1 id="hero-title">
          <span class="rise" style="animation-delay:0.22s">{home.hero.titleLine1}</span>
          <span class="rise" style="animation-delay:0.34s"><em>{home.hero.titleLine2}</em></span>
        </h1>
        <p class="hero-copy rise" style="animation-delay:0.5s">
          {home.hero.sub}
        </p>
        <div class="hero-actions rise" style="animation-delay:0.62s">
          <a class="button button-brand button-large" href={site.appUrl + site.registerPath}>
            {home.hero.primaryCta}
          </a>
          <a class="button button-ghost button-large" href={home.hero.secondaryCtaHref}>
            {home.hero.secondaryCta}
          </a>
        </div>
        <p class="hero-trust rise" style="animation-delay:0.72s">
          {home.hero.trust.map((item) => <span>{item}</span>)}
        </p>
      </div>
    </div>

    <div class="workflow-rail" aria-label="How Urban Events works">
      {home.workflow.map((item) => (
        <article>
          <span class="rail-step" aria-hidden="true">{item.step}</span>
          <div><strong>{item.title}</strong><small>{item.sub}</small></div>
        </article>
      ))}
    </div>
  </section>

  <!-- ===== PRODUCT PREVIEW ===== -->
  <section class="preview-section" aria-label="What an Urban Events page looks like">
    <div class="home-container">
      <div class="preview-frame" data-reveal>
        <div class="preview-chrome">
          <span class="preview-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="preview-url">urbanevents.pk/e/spring-music-night</span>
          <span class="preview-live"><i></i>Live</span>
        </div>

        <div class="preview-grid">
          <article class="preview-event">
            <div class="preview-cover">
              <span class="preview-badge">Lahore · Fri 20 Mar</span>
              <h3>Spring Music Night</h3>
              <p class="preview-cover-meta">Doors 6:00 pm · 400 seats</p>
            </div>

            <div class="preview-tiers">
              <div class="preview-tier">
                <span class="preview-tier-name">Regular</span>
                <span class="preview-tier-price">Rs 1,500</span>
                <span class="preview-tier-note">184 left</span>
              </div>
              <div class="preview-tier">
                <span class="preview-tier-name">VIP</span>
                <span class="preview-tier-price">Rs 4,000</span>
                <span class="preview-tier-note">22 left</span>
              </div>
            </div>

            <span class="preview-cta">Get tickets</span>
          </article>

          <aside class="preview-panel" aria-label="Door check-in panel">
            <div class="preview-panel-head">
              <span class="preview-panel-label">Door check-in</span>
              <span class="preview-panel-live"><i></i>Synced</span>
            </div>

            <p class="preview-count"><strong>312</strong><span>/ 400 in</span></p>
            <div class="preview-progress" aria-hidden="true"><span></span></div>

            <ul class="preview-log">
              <li><span>Hina R.</span><em>Delegate pass</em><small>now</small></li>
              <li><span>Bilal A.</span><em>VIP</em><small>12s</small></li>
              <li><span>Ayesha K.</span><em>Regular</em><small>31s</small></li>
            </ul>
          </aside>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== EVENT TYPES ===== -->
  <section class="ticker-band" aria-label="Built for">
    <div class="home-container">
      <p class="ticker-label">Built for</p>
      <ul class="ticker-list">
        {home.ticker.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <!-- ===== CAPABILITIES ===== -->
  <section class="home-section" id="capabilities" aria-labelledby="cap-title">
    <div class="home-container">
      <div class="home-head" data-reveal>
        <p class="home-kicker"><span class="kicker-rule"></span>What you get</p>
        <h2 id="cap-title">Everything from the first post to the door.</h2>
      </div>

      <div class="cap-grid">
        {capabilities.map((cap, i) => (
          <article class="cap" data-reveal>
            <div class="cap-top">
              <div class="cap-head">
                <span class="cap-icon" aria-hidden="true" set:html={capIcons[i]} />
                <span class="cap-num" aria-hidden="true">{"0" + (i + 1)}</span>
              </div>
              <h3>{cap.title}</h3>
              <p class="cap-desc">{cap.desc}</p>
            </div>
            <ul class="cap-points">
              {cap.points.map((point) => <li>{point}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== HOW IT WORKS ===== -->
  <section class="home-section" aria-labelledby="steps-title">
    <div class="home-container">
      <div class="home-head" data-reveal>
        <p class="home-kicker"><span class="kicker-rule"></span>{home.steps.kicker}</p>
        <h2 id="steps-title">{home.steps.heading}</h2>
        <p class="home-lede">{home.steps.lede}</p>
      </div>

      <div class="steps">
        {home.steps.items.map((item, i) => (
          <article class="step" data-reveal>
            <span class="step-num" aria-hidden="true">{"0" + (i + 1)}</span>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== PRICING ===== -->
  <section class="home-section" aria-labelledby="price-title">
    <div class="home-container">
      <div class="home-head" data-reveal>
        <p class="home-kicker"><span class="kicker-rule"></span>{home.pricing.kicker}</p>
        <h2 id="price-title">{home.pricing.heading}</h2>
        <p class="home-lede">{home.pricing.lede}</p>
      </div>

      <div class="pricing-grid" style="max-width: 880px;">
        {home.pricing.cards.map((tier) => (
          <article class="pricing-card" data-reveal data-featured={tier.featured ? "" : undefined}>
            <p class="pricing-tier">{tier.tier}</p>
            <p class="pricing-price">{tier.price} <small>{tier.note}</small></p>
            <p class="pricing-desc">{tier.desc}</p>
            <ul class="pricing-features">
              {tier.features.map((f) => <li>{f}</li>)}
            </ul>
            <a class={`button ${tier.featured ? "button-brand" : "button-ghost"} button-medium`} href={tier.href}>
              {tier.cta}
            </a>
          </article>
        ))}
      </div>

      <p class="home-more" data-reveal>
        <a class="button-arrow" href={home.pricing.moreHref}>{home.pricing.moreLabel}</a>
      </p>
    </div>
  </section>

  <!-- ===== ORIGIN ===== -->
  <section class="home-section" aria-labelledby="origin-title">
    <div class="home-container origin">
      <div class="home-head" data-reveal>
        <p class="home-kicker"><span class="kicker-rule"></span>{home.origin.kicker}</p>
        <h2 id="origin-title">{home.origin.heading}</h2>
      </div>

      <blockquote data-reveal>
        "{home.origin.quote}"
        <footer>{home.origin.attribution}</footer>
      </blockquote>

      <p class="home-more" data-reveal>
        <a class="button-arrow" href={home.origin.ctaHref}>{home.origin.ctaLabel}</a>
      </p>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="home-section" aria-labelledby="faq-title">
    <div class="home-container">
      <div class="home-head" data-reveal>
        <p class="home-kicker"><span class="kicker-rule"></span>FAQs</p>
        <h2 id="faq-title">The questions we get most.</h2>
      </div>

      <FAQList items={home.faqTeaser} />

      <p class="home-more" data-reveal>
        <a class="button-arrow" href="/faqs">Read all FAQs</a>
      </p>
    </div>
  </section>

  <!-- ===== CLOSING CTA ===== -->
  <section class="home-section" aria-label="Get started">
    <div class="home-container">
      <div class="home-cta" data-reveal>
        <h2>{home.cta.headingLine1} <em>{home.cta.headingLine2}</em></h2>
        <div class="hero-actions">
          <a class="button button-brand button-large" href={home.cta.primaryCtaHref}>
            {home.cta.primaryCta}
          </a>
          <a class="button button-ghost button-large" href={home.cta.secondaryCtaHref}>
            {home.cta.secondaryCta}
          </a>
        </div>
        <p class="home-cta-note">{home.cta.sub}</p>
      </div>
    </div>
  </section>
</Layout>