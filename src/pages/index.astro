---
import Layout from "@layouts/Layout.astro";
import MomentsCarousel from "@components/MomentsCarousel.astro";
import { site } from "@content/site";
import { home } from "@content/home";
---

<Layout title={site.title} description={site.description} canonical="/">

  <!-- ===== HERO ===== -->
  <MomentsCarousel />

  <!-- ===== MARQUEE (yellow) ===== -->
  <section class="marquee-section" style="padding-top: var(--space-huge); padding-bottom: var(--space-huge); border-bottom: 3px solid var(--color-ink); display: flex; flex-direction: column; justify-content: center; min-height: 40vh;">
    <div class="marquee-inner">
      <p class="type-large-title-120" data-reveal>{home.marquee}</p>
      <p class="marquee-tag" data-reveal>
        <span class="type-heading">{home.marqueeTag}</span>
      </p>
    </div>
  </section>

  <!-- ===== FEATURES (cream) ===== -->
  <section class="section-features" style="border-bottom: 3px solid var(--color-ink);">
    <div class="features-inner" style="max-width: 800px; margin: 0 auto; text-align: center; padding: var(--space-huge) 0;">
      <h2 class="type-h3" data-reveal style="margin-bottom: var(--space-sm);">{home.features.heading}</h2>
      <div data-reveal>
        <h3 class="type-h2" style="margin-bottom: var(--space-md);">{home.features.main}</h3>
        <p class="type-body" style="font-size: 24px; color: var(--ink-soft); line-height: 1.6;">
          {home.features.todoItems.join(', ')}
        </p>
      </div>
    </div>
  </section>

  <!-- ===== MISSION (cyan) ===== -->
  <section class="section-mission" style="padding-top: var(--space-huge); padding-bottom: var(--space-huge); border-bottom: 3px solid var(--color-ink);">
    <div class="mission-inner">
      <h2 class="type-large-title-100" data-reveal>{home.mission.heading}</h2>
      <p class="type-heading" data-reveal style="color: var(--ink); font-size: 18px; max-width: 600px; margin-top: var(--space-sm);">{home.mission.sub}</p>
    </div>
  </section>

  <!-- ===== FEATURE GRID (cream) ===== -->
  <section class="section-feature-grid" style="background: var(--cream); padding: var(--space-huge) 0; border-bottom: 3px solid var(--color-ink);">
    <div class="container-inner" style="display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-md);">
      <div class="sticker-pill bg-pink sticker"><span class="type-h4">Tickets</span></div>
      <div class="sticker-pill bg-lavender sticker"><span class="type-h4">Events</span></div>
      <div class="sticker-pill bg-mint sticker"><span class="type-h4">Analytics</span></div>
      <div class="sticker-pill bg-peach sticker"><span class="type-h4">Workshops</span></div>
      <div class="sticker-pill bg-yellow sticker"><span class="type-h4">Societies</span></div>
    </div>
  </section>

  <!-- ===== ORIGIN (cream overlap card on peach bg) ===== -->
  <div class="section-origin-bg" style="background: var(--peach); padding-bottom: var(--space-huge);">
    <section class="section-origin" style="padding-top: var(--space-huge); padding-bottom: var(--space-huge);">
      <div class="origin-inner">
        <p class="type-heading" data-reveal>{home.origin.intro}</p>
        <h2 class="type-large-title" data-reveal>{home.origin.headline}</h2>
        <div data-reveal style="background-color: var(--color-white); border: 3px solid var(--color-ink); border-radius: var(--radius-lg); padding: var(--space-md); box-shadow: var(--shadow-sm); max-width: 600px; transform: rotate(-1deg);">
          <p class="type-body" style="font-size: clamp(20px,2.5vw,26px); color: var(--ink); font-weight: 500; line-height: 1.5;">{home.origin.body}</p>
        </div>
        <a class="pill-button" href={home.origin.ctaHref} id="origin-about-cta" data-reveal
          style="background: var(--color-mint); color: var(--ink); margin-top: var(--space-sm);">
          {home.origin.ctaLabel}
        </a>
      </div>
    </section>
  </div>

  <!-- ===== FINAL CTA ===== -->
  <section class="section-final-cta" style="background: var(--color-mint); border-radius: 50% 50% 0 0 / 150px 150px 0 0; padding: 160px 32px 100px; text-align: center; border-top: 3px solid var(--color-ink); margin-top: -80px; position: relative; z-index: 10;">
    <div class="final-cta-inner" style="max-width: var(--container-max); margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 28px;">
      <h2 class="type-large-title" style="font-size: clamp(44px, 8vw, 100px); color: var(--ink);">{home.cta.heading}</h2>
      <a class="pill-button" href={home.cta.primaryCtaHref} style="font-size: 18px; padding: 0 40px; min-height: 60px; background: var(--color-yellow);">{home.cta.primaryCta}</a>
    </div>
  </section>

</Layout>

<style>
  /* ---- Feature card face decoration ---- */
  .feature-main-card {
    position: relative;
  }

  /* ---- Floating face stickers in mission ---- */
  .sticker-pill {
    padding: 12px 24px;
    border: 3px solid var(--color-ink);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-sm);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .bg-pink { background-color: var(--color-pink); }
  .bg-lavender { background-color: var(--color-lavender); }
  .bg-mint { background-color: var(--color-mint); }
  .bg-peach { background-color: var(--color-peach); }
  .bg-yellow { background-color: var(--color-yellow); }

  /* ---- Origin section face ---- */
  .section-origin {
    position: relative;
  }

  /* ---- Final CTA giant background face ---- */
  .section-final-cta {
    position: relative;
    overflow: hidden;
  }

  /* ---- Gentle floating animation ---- */
  @keyframes gentle-float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-12px) rotate(3deg); }
  }

  /* Phone mockups */
  .phones {
    position: relative;
    height: 380px;
    margin-top: 40px;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  .phone {
    width: 190px;
    height: 370px;
    border-radius: var(--radius-xl);
    border: 3px solid var(--ink);
    box-shadow: var(--shadow);
    position: absolute;
  }

  .phone-1 {
    --rot: rotate(-8deg) translateX(-180px);
    transform: var(--rot);
    animation: phone-float 5s ease-in-out infinite 0.5s;
  }

  .phone-2 {
    z-index: 2;
    animation: phone-float 4s ease-in-out infinite;
  }

  .phone-3 {
    --rot: rotate(8deg) translateX(180px);
    transform: var(--rot);
    animation: phone-float 6s ease-in-out infinite 1s;
  }

  @keyframes phone-float {
    0%, 100% { transform: var(--rot, translateY(0)); }
    50% { transform: var(--rot, translateY(0)) translateY(-12px); }
  }

  @media (max-width: 600px) {
    .phone { width: 130px; height: 260px; }
    .phones { height: 300px; }
    .phone-1 { --rot: rotate(-8deg) translateX(-100px); }
    .phone-3 { --rot: rotate(8deg) translateX(100px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .phone-1, .phone-2, .phone-3 { animation: none; }
  }
</style>
