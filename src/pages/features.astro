---
import Layout from "@layouts/Layout.astro";
import { pages } from "@content/pages";
import { site } from "@content/site";

const page = pages.features;
---

<Layout title={page.title} description={page.description} canonical="/features">
  <section class="subpage-section">
    <div class="container">
      <p class="kicker" data-reveal>{page.eyebrow}</p>
      <h1 data-reveal style="font-size: clamp(36px,4.6vw,64px); letter-spacing:-0.045em; line-height:1.02; max-width:820px;">
        {page.heading}
      </h1>
      <div class="subpage-body" data-reveal>
        <p>{page.subheading}</p>
      </div>
    </div>
  </section>

  <section class="section" style="border-top: 0; padding-top: 0;">
    <div class="container">
      <div class="card-grid">
        {page.items.map((item, i) => (
          <article
            class:list={["card", { "card-wide": i === page.items.length - 1 && page.items.length % 3 === 1 }]}
            data-reveal
          >
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-band-inner">
      <h2 data-reveal>Ready to sell tickets?</h2>
      <div class="hero-actions" data-reveal>
        <a class="button button-brand button-large" href={site.appUrl + site.registerPath}>Create your event</a>
      </div>
    </div>
  </section>
</Layout>
